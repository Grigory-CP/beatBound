# Copy this file to .env (same folder) and fill in your project's values.
# .env is gitignored. Never commit real keys.
#
# Supabase dashboard -> Project Settings -> Data API: Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys (starts with sb_secret_)
# Backend only: this key bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
